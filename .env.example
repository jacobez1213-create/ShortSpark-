PORT=4242
NODE_ENV=production
ADMIN_PASSWORD=replace-with-a-long-random-password
COOKIE_SECRET=replace-with-another-long-random-secret

# Neon Postgres pooled connection string
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_CREATOR=price_replace_me
STRIPE_PRICE_PRO=price_replace_me

REPLICATE_API_TOKEN=r8_replace_me
VIDEO_MODEL=wan-video/wan-2.2-5b-fast
TTS_MODEL=inworld/realtime-tts-1.5-mini
TTS_VOICE_ID=Ashley

FREE_VIDEOS_PER_DAY=1
CREATOR_VIDEOS_PER_MONTH=10
PRO_VIDEOS_PER_MONTH=24

# Optional public HTTPS origin, e.g. https://shortspark-uirp.onrender.com
PUBLIC_ORIGIN=

WAN_SAMPLE_SHIFT=12

OWNER_BYPASS_LIMITS=true

# AI customer support (optional; without it, a built-in FAQ fallback is used)
OPENAI_API_KEY=sk_replace_me
SUPPORT_MODEL=gpt-6-luna

# One-time 50% first-user Stripe promotion code shown in Developer mode
FIRST_USER_SUPPORT_CODE=SHORTSPARK50

# Supabase Storage (recommended for generated MP4s; keeps video files off the free web server)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=shortspark-videos
